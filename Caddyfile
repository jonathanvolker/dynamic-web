{
  on_demand_tls {
    ask http://app:3000/api/domains/allow
  }
}

{$DOMAIN} {
  encode zstd gzip
  @public_leads path /api/public/leads
  handle @public_leads {
    request_body {
      max_size 128KB
    }
    reverse_proxy app:3000 {
      header_up X-Forma-Client-IP {remote_host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
    }
  }
  handle {
    reverse_proxy app:3000 {
      header_up X-Forma-Client-IP {remote_host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
    }
  }
}

:443 {
  tls {
    on_demand
  }
  encode zstd gzip
  @public_leads path /api/public/leads
  handle @public_leads {
    request_body {
      max_size 128KB
    }
    reverse_proxy app:3000 {
      header_up X-Forma-Client-IP {remote_host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
    }
  }
  handle {
    reverse_proxy app:3000 {
      header_up X-Forma-Client-IP {remote_host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
    }
  }
}
