# La plataforma y Payload usan la misma base PostgreSQL.
DATABASE_URI=postgresql://forma:change-this-password@localhost:5432/forma
DATABASE_POOL_MAX=10
# Los binarios de media permanecen en este directorio hasta migrar a object storage.
PLATFORM_DATA_DIR=./data
COOKIE_SECURE=false
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
POSTGRES_PASSWORD=change-this-password
DOMAIN=example.com
PLATFORM_ADMIN_EMAILS=facundosvalit@gmail.com
# También se acepta un único email para instalaciones simples.
PLATFORM_ADMIN_EMAIL=facundosvalit@gmail.com
FORMA_CNAME_TARGET=forma.example.com
# Activar solo cuando el tráfico llega mediante Caddy/WAF que sobrescribe los headers.
TRUST_PROXY_HEADERS=false
PLAN_INITIAL_PRICE_ARS=6000
PLAN_PROFESSIONAL_PRICE_ARS=19000
MERCADOPAGO_ACCESS_TOKEN=replace-with-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=replace-with-mercadopago-webhook-secret
MERCADOPAGO_WEBHOOK_URL=https://your-public-url.example/api/billing/mercadopago
