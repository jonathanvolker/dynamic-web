# La plataforma local usa SQLite; PostgreSQL no es necesario para el editor.
PLATFORM_DATA_DIR=./data
COOKIE_SECURE=false
# Configuración del CMS de la primera demo (opcional, separado de la plataforma).
# DATABASE_URI=postgresql://forma:change-this-password@localhost:5432/forma
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
POSTGRES_PASSWORD=change-this-password
DOMAIN=example.com
# Emails con acceso al panel de administración, separados por coma.
PLATFORM_ADMIN_EMAILS=admin@example.com
